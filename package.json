{
  "name": "empires-war",
  "private": true,
  "version": "0.0.1",
  "description": "Empires-War: RTS histórico isométrico para navegador. Proyecto original inspirado en AoE II DE.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "test": "tsx --test tests/*.test.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:dist",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "e2e:cloud": "node scripts/cloud-e2e.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "@supabase/supabase-js": "2.117.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.56.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  }
}
